# Copy to .env and adjust values. NEVER commit .env.

# PostgreSQL (docker-compose dev defaults shown; local port 5433, asyncpg driver for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://interview:interview@localhost:5433/interview

# Admin login password (single admin account)
ADMIN_PASSWORD=change-me

# Secret for signing JWTs (admin + candidate session tokens)
JWT_SECRET=change-me-jwt-secret

# Fernet key for encrypting exam-link tokens.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LINK_ENCRYPTION_KEY=

# OpenAI-compatible grading API (leave AI_API_KEY empty to run without AI; grading tasks then go to "failed")
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Public base URL used to build exam links
FRONTEND_URL=http://localhost:5173
